# ============================================================
#  CONFIGURAÇÕES DO SISTEMA — Gerador de Atividades SENAI
#  Copie este arquivo para o novo computador e ajuste os valores
# ============================================================

# --- Banco de Dados PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gerador_atividades
DB_USER=postgres
DB_PASSWORD=123

# --- Flask ---
# IMPORTANTE: Troque por uma string aleatória longa no servidor de produção!
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=gerador_atividades_2026

# --- Ollama (IA) ---
# Modelo otimizado para alta velocidade e baixo consumo de memória (3B)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180

# --- Servidor Waitress ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_THREADS=4
