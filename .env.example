# ============================================================
#  EXEMPLO DE CONFIGURAÇÃO — copie para .env e preencha
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gerador_atividades
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

FLASK_SECRET_KEY=GERE_UMA_CHAVE_AQUI

# Segurança em Rede Local (Opcional):
# Se definida, a tela "Esqueci minha senha" exige essa chave para redefinir.
# Se deixada vazia, a redefinição é direta por e-mail ou feita pelo painel Admin (/usuarios).
CHAVE_RECUPERACAO_SENHA=

# Provedor: auto | ollama | gemini | openai
IA_PROVIDER=auto

# Ollama local (offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Google Gemini API (gratuita e ultra rápida)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# OpenAI / Groq / LM Studio (opcional)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_THREADS=4
